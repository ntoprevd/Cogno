# Never commit real provider keys.
PORT=8787
HOST=0.0.0.0
COGNO_GATEWAY_ENABLED=true
COGNO_APP_TOKEN=replace-with-a-random-demo-gate-token
GLM_API_KEY=replace-with-your-provider-key
OSS_ACCESS_KEY_ID=replace-with-your-oss-ram-access-key-id
OSS_ACCESS_KEY_SECRET=replace-with-your-oss-ram-access-key-secret
OSS_BUCKET=cogno-temporary-images
OSS_ENDPOINT=https://oss-cn-hongkong.aliyuncs.com

# Loose demo limits. Adjust before public deployment.
DAILY_REQUEST_LIMIT=200
DAILY_TOKEN_LIMIT=1000000
MAX_INPUT_CHARS=60000
MAX_OUTPUT_TOKENS=8192
MAX_IMAGE_BYTES=5242880
IMAGE_URL_TTL_SECONDS=900
