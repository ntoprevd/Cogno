<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- API credentials are device-bound and must never enter cloud backups. -->
        <exclude domain="sharedpref" path="cogno_ai_settings.xml"/>
        <exclude domain="database" path="cogno.db"/>
        <exclude domain="file" path="chat_images"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="cogno_ai_settings.xml"/>
        <exclude domain="database" path="cogno.db"/>
        <exclude domain="file" path="chat_images"/>
    </device-transfer>
</data-extraction-rules>
